# Default: let git normalise text in the repository and check out native endings.
* text=auto

# These must stay LF whatever the host does. They are read inside Linux
# containers, where a CRLF shebang fails with "bad interpreter" and a CRLF
# swanctl.conf can be mis-parsed. Checking this out on Windows with CRLF would
# break the testbed in a way that is tedious to diagnose.
*.sh            text eol=lf
testbed/entrypoint.sh   text eol=lf
**/swanctl.conf text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile*     text eol=lf

# Captures are binary. Marking them stops git from trying to normalise or diff
# them, which would corrupt a pcapng.
*.pcap          binary
*.pcapng        binary
*.cap           binary
